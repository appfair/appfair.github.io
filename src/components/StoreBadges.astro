---
import { site } from '../lib/site';
import { useTranslations } from '../i18n';
const { t } = useTranslations(Astro.currentLocale);
---
<div class="stores">
  {site.stores.map((store) => (
    <a class="store-badge" href={store.href} rel="noopener" aria-label={t(`home.stores.${store.id}`)}>
      <img src={store.badge} alt="" height="44" loading="lazy" decoding="async" />
    </a>
  ))}
</div>
